# Serves mailmenu.aak.sh, assuming the repo is cloned to /srv/aak.sh.
# Not imported: copy this block into the server's main Caddyfile, and update it there when it changes.
# Only site/public/ is served; everything else in site/ stays private.
mailmenu.aak.sh {
	root * /srv/aak.sh/mailmenu/site/public
	encode zstd gzip
	file_server
}
