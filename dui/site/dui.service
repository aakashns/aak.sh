# dui.aak.sh: the site's Bun server, behind Caddy (see Caddyfile). It runs as whoever deploys it,
# with their Bun. Install it, as them, with
#   sed "s|@USER@|$(whoami)|; s|@HOME@|$HOME|" dui.service | sudo tee /etc/systemd/system/dui.service >/dev/null
#   sudo systemctl daemon-reload && sudo systemctl enable --now dui
[Unit]
Description=dui.aak.sh
After=network.target

[Service]
Type=exec
WorkingDirectory=/srv/aak.sh/dui/site
User=@USER@
ExecStart=@HOME@/.bun/bin/bun src/server.ts
Environment=HOST=127.0.0.1
Environment=PORT=44200
# Its home folder is read-only, so Bun can't cache transpiled files there.
Environment=BUN_RUNTIME_TRANSPILER_CACHE_PATH=0
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_INET AF_INET6
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
